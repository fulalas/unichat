<?xml version="1.0" encoding="utf-8"?>
<!-- Determinate circular progress ring (WhatsApp-style): a faint full ring as
     the track, with a solid ring arc drawn on top proportional to the level,
     starting at the top (12 o'clock) and sweeping clockwise. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:shape="ring"
            android:useLevel="false"
            android:innerRadiusRatio="2.6"
            android:thicknessRatio="16">
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape
                android:shape="ring"
                android:useLevel="true"
                android:innerRadiusRatio="2.6"
                android:thicknessRatio="16">
                <solid android:color="#FFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>
