<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/dateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/date_chip_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/messageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/senderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/chatAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/forwardedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/forwarded"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quotePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quote_bg"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="4dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/audioRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/audioButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/badge_bg"
                android:padding="12dp"
                android:contentDescription="@string/play" />

            <!-- waveform + length/dot stacked into one column; the play button
                 and speed pill sit vertically centered against it, so the
                 button lands in the middle of the whole bubble's height -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/audioSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="?attr/chatAccent"
                    android:thumbTint="?attr/chatAccent"
                    android:progressBackgroundTint="@color/text_secondary" />

                <!-- voice length + played dot, under the waveform, bottom-left;
                     nudged right to line up with the seekbar track's start
                     (past the thumb inset) rather than the seekbar's edge -->
                <LinearLayout
                    android:id="@+id/audioMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="1dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/audioDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/audioUnplayedDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_bg"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- fixed width so 1× / 1.5× / 2× don't resize it and shift the row -->
            <TextView
                android:id="@+id/audioSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/reaction_pill_bg"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- video: an icon button (download / spinner / play) plus a label.
             Tapping the icon downloads-or-opens; tapping the rest of the
             bubble downloads and then auto-opens once ready. -->
        <LinearLayout
            android:id="@+id/videoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/videoButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:focusable="true"
                android:background="@drawable/badge_bg"
                android:contentDescription="@string/download">

                <!-- decorative: the tappable frame above carries the label, and
                     applyVideoState keeps it in step with what a tap will do -->
                <ImageView
                    android:id="@+id/videoIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_download"
                    android:padding="12dp"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <ProgressBar
                    android:id="@+id/videoProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    android:max="100"
                    android:progressDrawable="@drawable/circular_progress"
                    android:visibility="gone" />

                <!-- shown until a real percentage is known (connecting, or a
                     sender that omitted the file size) so the ring is never a
                     motionless 0% -->
                <ProgressBar
                    android:id="@+id/videoSpinner"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/videoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/imageFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/messageImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <!-- timestamp drawn over the photo's bottom corner, WhatsApp-style;
                 shown instead of messageTime on captionless photos -->
            <TextView
                android:id="@+id/imageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/image_time_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textColorLink="?attr/chatAccent" />

        <TextView
            android:id="@+id/messageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/reactionPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-9dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:background="@drawable/reaction_pill_bg"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
