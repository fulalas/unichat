<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/signal_link_help"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="264dp"
            android:layout_height="264dp"
            android:layout_marginTop="24dp">

            <ImageView
                android:id="@+id/sgQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:visibility="invisible"
                android:contentDescription="@string/signal_link_title" />

            <ProgressBar
                android:id="@+id/sgQrProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/sgLinkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/signal_link_waiting"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/sgRegisterInstead"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/signal_link_register_instead"
            android:textColor="@color/accent_sg" />
    </LinearLayout>
</ScrollView>
