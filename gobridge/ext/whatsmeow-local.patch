diff --git a/user.go b/user.go
index 9d846ea..2823f10 100644
--- a/user.go
+++ b/user.go
@@ -168,7 +168,48 @@ func (cli *Client) SetStatusMessage(ctx context.Context, status types.SetStatusI
 		"input": &status,
 	})
 	// TODO check output result?
-	return err
+	if err == nil {
+		return nil
+	}
+	// The mex mutation above is rejected outright for some accounts (the server
+	// answers the GraphQL request with 400 Bad Request), which would leave no
+	// way to set an About at all. Only the plain-text case can be retried in
+	// another shape, so anything richer keeps the original error.
+	if status.Emoji != nil || status.Duration.Duration != 0 || status.Text == nil {
+		return err
+	}
+	cli.Log.Warnf("Setting status via mex failed (%v), trying fallbacks", err)
+	// Two other shapes of the same mutation: without the duration field at all,
+	// and with the 24h duration WhatsApp Web was seen sending (whatsmeow#1219,
+	// whose author captured it before the merged version defaulted it to zero).
+	for _, input := range []map[string]any{
+		{"text": *status.Text},
+		{"text": *status.Text, "ephemeral_duration_sec": 86400},
+	} {
+		_, mexErr := cli.sendMexIQ(ctx, mutationUpdateTextStatus, map[string]any{"input": input})
+		if mexErr == nil {
+			cli.Log.Warnf("Status mex fallback %+v succeeded", input)
+			return nil
+		}
+		cli.Log.Warnf("Status mex fallback %+v failed: %v", input, mexErr)
+	}
+	// Last resort: the IQ this call used before the switch to mex. Upstream
+	// switched away because the server started accepting it without applying
+	// the change, so a success here is not proof the About really changed.
+	if _, iqErr := cli.sendIQ(ctx, infoQuery{
+		Namespace: "status",
+		Type:      iqSet,
+		To:        types.ServerJID,
+		Content: []waBinary.Node{{
+			Tag:     "status",
+			Content: *status.Text,
+		}},
+	}); iqErr != nil {
+		cli.Log.Warnf("Legacy status IQ fallback failed: %v", iqErr)
+		return err
+	}
+	cli.Log.Warnf("Legacy status IQ fallback succeeded")
+	return nil
