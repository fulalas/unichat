+
+// SendNoteToSelf delivers a message addressed to our own account.
+//
+// Signal has no recipient to encrypt for here, so SendMessage reports failure
+// with an empty result. A note to self is instead a SyncMessage.Sent addressed
+// to ourselves: our other devices pick it up, and with no other devices the
+// send is simply a no-op that still succeeds.
+func (cli *Client) SendNoteToSelf(ctx context.Context, content *signalpb.Content) error {
+	self := cli.Store.ACIServiceID()
+	var sent *signalpb.SyncMessage_Sent
+	var timestamp uint64
+
+	switch c := content.Content.(type) {
+	case *signalpb.Content_DataMessage:
+		timestamp = c.DataMessage.GetTimestamp()
+		sent = &signalpb.SyncMessage_Sent{
+			Message:                    c.DataMessage,
+			DestinationServiceIdBinary: self.Bytes(),
+			Timestamp:                  c.DataMessage.Timestamp,
+			ExpirationStartTimestamp:   ptr.Ptr(uint64(time.Now().UnixMilli())),
+		}
+	case *signalpb.Content_EditMessage:
+		timestamp = c.EditMessage.GetDataMessage().GetTimestamp()
+		sent = &signalpb.SyncMessage_Sent{
+			EditMessage:                c.EditMessage,
+			DestinationServiceIdBinary: self.Bytes(),
+			Timestamp:                  c.EditMessage.GetDataMessage().Timestamp,
+		}
+	default:
+		// Typing and receipts have no meaning addressed at yourself.
+		return nil
+	}
+
+	_, err := cli.sendContent(ctx, self, timestamp, syncSentMessage(sent), 0, true, nil, nil)
+	return err
+}
diff --git a/pkg/signalmeow/svr2.go b/pkg/signalmeow/svr2.go
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/pkg/signalmeow/svr2.go
@@ -0,0 +1,299 @@
+package signalmeow
+
+// Recovering the account master key from SVR2 (Secure Value Recovery v2).
+//
+// The master key is what decrypts the storage service — the contact list,
+// groups and settings. A linked device is handed it by the primary. A device
+// that REGISTERS mints a new one, which leaves the account's existing storage
+// manifest on the server but unreadable. SVR2 is the only way back: the user's
+// PIN, stretched inside an SGX enclave, unwraps the original key.
+//
+// The enclave is the same kind CDSI uses, so the handshake reuses
+// libsignalgo.SGXClientState; only the enclave id, the URL and the request
+// protobuf differ.
+
+import (
+	"context"
+	"crypto/hmac"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"path"
+	"strings"
+	"time"
+
+	"github.com/coder/websocket"
+	"google.golang.org/protobuf/proto"
+
+	"go.mau.fi/mautrix-signal/pkg/libsignalgo"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/protobuf/svr2pb"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/web"
+)
+
+const (
+	svr2Hostname = "svr2.signal.org"
+)
+
+// The enclave id is part of the PIN salt, so it is not a detail that can be left
+// approximate: the wrong one derives the wrong access key, and the enclave then
+// answers about a record that is not the account's.
+//
+// Signal runs the outgoing enclave alongside the current one while records
+// migrate, and the old one keeps answering — with a stale key, which is accepted
+// by the PIN and then cannot open the storage manifest. So the current enclave
+// is tried first and the previous one only as a fallback, in the order
+// libsignal's own prod config lists them (rust/net/src/env.rs, Svr2Env
+// current/previous). Both must be bumped in step with the libsignal version
+// this links against.
+var svr2MrEnclaves = []string{
+	// ENCLAVE_ID_SVR2_2026Q2_PROD
+	"ced8217b26228e4b210c985786999d095c4958a94faf37b14acaf25c4cbb02a4",
+	// ENCLAVE_ID_SVR2_2026Q1_PROD
+	"1240acbd4aa26974184844c8a46b1022d3957ac8a76c1fd8f5b1a15141ee0708",
+}
+
+// SVR2RestoreError distinguishes the outcomes the user can act on from the ones
+// they cannot.
+type SVR2RestoreError struct {
+	Status svr2pb.RestoreResponse_Status
+	Tries  uint32
+}
+
+func (e SVR2RestoreError) Error() string {
+	switch e.Status {
+	case svr2pb.RestoreResponse_PIN_MISMATCH:
+		return fmt.Sprintf("wrong PIN, %d tries left", e.Tries)
+	case svr2pb.RestoreResponse_MISSING:
+		return "no backup stored for this account"
+	default:
+		return fmt.Sprintf("restore failed (%s)", e.Status)
+	}
+}
+
+type svr2Credentials struct {
+	Username string `json:"username"`
+	Password string `json:"password"`
+}
+
+func (cli *Client) getSVR2Credentials(ctx context.Context) (*svr2Credentials, error) {
+	username, password := cli.Store.BasicAuthCreds()
+	resp, err := web.SendHTTPRequest(ctx, web.APIHostname, http.MethodGet, "/v2/svr/auth", &web.HTTPReqOpt{
+		Username: &username,
+		Password: &password,
+	})
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("svr2 auth returned %d: %s", resp.StatusCode, string(body))
+	}
+	creds := &svr2Credentials{}
+	if err := json.Unmarshal(body, creds); err != nil {
+		return nil, fmt.Errorf("failed to parse svr2 auth: %w", err)
+	}
+	return creds, nil
+}
+
+// RestoreMasterKeyFromSVR2 exchanges the account PIN for the stored master key.
+//
+// Returns every plausible reading of the enclave's payload, best first, because
+// the wire format is not self-describing: the proto caps the stored blob at 48
+// bytes, which a GCM-wrapped 32-byte key (32+12+16) cannot fit, so the common
+// case is the key stored raw. The caller settles it by trying each against the
+// storage service — the only definitive test.
+func (cli *Client) RestoreMasterKeyFromSVR2(ctx context.Context, pin string) ([][]byte, error) {
+	var lastErr error
+	for _, enclave := range svr2MrEnclaves {
+		candidates, err := cli.restoreFromEnclave(ctx, pin, enclave)
+		if err == nil {
+			return candidates, nil
+		}
+		lastErr = err
+		// A wrong PIN is the user's answer and the same everywhere, so stop
+		// rather than spending another of their tries on the next enclave. Any
+		// other outcome — no record here, or a migration in progress — is worth
+		// asking the older enclave about.
+		var restoreErr SVR2RestoreError
+		if errors.As(err, &restoreErr) &&
+			restoreErr.Status == svr2pb.RestoreResponse_PIN_MISMATCH {
+			return nil, err
+		}
+	}
+	return nil, lastErr
+}
+
+func (cli *Client) restoreFromEnclave(
+	ctx context.Context, pin string, mrEnclaveHex string,
+) ([][]byte, error) {
+	mrenclave, err := hex.DecodeString(mrEnclaveHex)
+	if err != nil {
+		return nil, fmt.Errorf("bad enclave id: %w", err)
+	}
+
+	creds, err := cli.getSVR2Credentials(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	// The PIN is stretched against the enclave id and the SVR username, so the
+	// resulting keys are useless anywhere else.
+	pinHash, err := libsignalgo.PinHashFromUsernameMrenclave(
+		[]byte(normalizePIN(pin)), creds.Username, mrenclave,
+	)
+	if err != nil {
+		return nil, fmt.Errorf("failed to hash PIN: %w", err)
+	}
+	defer pinHash.Destroy()
+
+	accessKey, err := pinHash.AccessKey()
+	if err != nil {
+		return nil, err
+	}
+	encryptionKey, err := pinHash.EncryptionKey()
+	if err != nil {
+		return nil, err
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+
+	// Credentials ride in the URL userinfo, the same way contact discovery
+	// authenticates to its enclave.
+	addr := (&url.URL{
+		Scheme: "wss",
+		Host:   svr2Hostname,
+		User:   url.UserPassword(creds.Username, creds.Password),
+		Path:   path.Join("v1", mrEnclaveHex),
+	}).String()
+	ws, _, err := web.OpenWebsocket(ctx, addr)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open svr2 socket: %w", err)
+	}
+	defer ws.Close(websocket.StatusInternalError, "svr2 done")
+
+	// The enclave sends its attestation first; the handshake proves we are
+	// talking to genuine SVR2 code and not the server relaying our PIN.
+	_, attestation, err := ws.Read(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read attestation: %w", err)
+	}
+	sgx, err := libsignalgo.NewSVR2ClientState(mrenclave, attestation, time.Now())
+	if err != nil {
+		return nil, fmt.Errorf("attestation rejected: %w", err)
+	}
+	defer sgx.Destroy()
+
+	initial, err := sgx.InitialRequest()
+	if err != nil {
+		return nil, err
+	}
+	if err := ws.Write(ctx, websocket.MessageBinary, initial); err != nil {
+		return nil, fmt.Errorf("failed to send handshake: %w", err)
+	}
+	_, handshakeResp, err := ws.Read(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read handshake: %w", err)
+	}
+	if err := sgx.CompleteHandshake(handshakeResp); err != nil {
+		return nil, fmt.Errorf("handshake failed: %w", err)
+	}
+
+	request := &svr2pb.Request{
+		Inner: &svr2pb.Request_Restore{
+			Restore: &svr2pb.RestoreRequest{Pin: accessKey},
+		},
+	}
+	plaintext, err := proto.Marshal(request)
+	if err != nil {
+		return nil, err
+	}
+	sealed, err := sgx.EstablishedSend(plaintext)
+	if err != nil {
+		return nil, err
+	}
+	if err := ws.Write(ctx, websocket.MessageBinary, sealed); err != nil {
+		return nil, fmt.Errorf("failed to send restore: %w", err)
+	}
+	_, sealedResp, err := ws.Read(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read restore: %w", err)
+	}
+	respBytes, err := sgx.EstablishedReceive(sealedResp)
+	if err != nil {
+		return nil, err
+	}
+	response := &svr2pb.Response{}
+	if err := proto.Unmarshal(respBytes, response); err != nil {
+		return nil, err
+	}
+	restore := response.GetRestore()
+	if restore == nil {
+		return nil, fmt.Errorf("svr2 returned no restore response")
+	}
+	if restore.GetStatus() != svr2pb.RestoreResponse_OK {
+		return nil, SVR2RestoreError{Status: restore.GetStatus(), Tries: restore.GetTries()}
+	}
+
+	data := restore.GetData()
+	candidates := make([][]byte, 0, 2)
+	if len(data) == 32 {
+		candidates = append(candidates, data)
+	}
+	if unwrapped, err := decryptSVR2Data(encryptionKey, data); err == nil {
+		candidates = append(candidates, unwrapped)
+	}
+	if len(candidates) == 0 {
+		return nil, fmt.Errorf("svr2 returned %d bytes that fit no known layout", len(data))
+	}
+	return candidates, nil
+}
+
+// decryptSVR2Data unwraps the 48-byte blob SVR2 stores: HMAC-SHA256-SIV, which
+// is 16 bytes of synthetic IV followed by 32 bytes of ciphertext.
+//
+// Not AES-GCM, though the length is suggestive. The scheme is a keystream XOR
+// with the IV doubling as the authentication tag, and it is what libsignal's
+// PinHash::decode_master_key does (rust/account-keys/src/hash.rs). The whole
+// point of the fixed 48 bytes is that the proto caps the stored value there.
+func decryptSVR2Data(key, data []byte) ([]byte, error) {
+	const ivSize = 16
+	if len(data) != 48 {
+		return nil, fmt.Errorf("svr2 payload is %d bytes, expected 48", len(data))
+	}
+	kA := hmacSHA256(key, []byte("auth"))
+	kE := hmacSHA256(key, []byte("enc"))
+	iv, ciphertext := data[:ivSize], data[ivSize:]
+
+	kX := hmacSHA256(kE, iv)
+	master := make([]byte, len(ciphertext))
+	for i := range ciphertext {
+		master[i] = kX[i] ^ ciphertext[i]
+	}
+
+	// The IV is a MAC over the plaintext, so recomputing it authenticates the
+	// result; a wrong key yields plausible-looking bytes otherwise.
+	expectedIV := hmacSHA256(kA, master)[:ivSize]
+	if !hmac.Equal(iv, expectedIV) {
+		return nil, fmt.Errorf("svr2 payload failed authentication")
+	}
+	return master, nil
+}
+
+// normalizePIN matches what other Signal clients hash. A numeric PIN is used
+// exactly as typed; an alphanumeric one is lowercased, which is the only
+// transform Signal applies. Getting this wrong produces a valid-looking hash
+// that simply never matches.
+func normalizePIN(pin string) string {
+	for _, r := range pin {
+		if r < '0' || r > '9' {
+			return strings.ToLower(pin)
+		}
+	}
+	return pin
+}
