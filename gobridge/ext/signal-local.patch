+//go:build android
+
+package libsignalgo
+
+/*
+// Upstream links -lstdc++, which on the NDK is only a stub, while
+// libsignal_ffi.a genuinely needs a C++ runtime: BoringSSL's C++ half plus the
+// __cxa_* unwinder Rust panics go through.
+//
+// It has to be the STATIC libc++. gomobile packages only libgojni.so into the
+// aar, so a DT_NEEDED on libc++_shared.so builds and installs fine and then
+// kills the app at startup with "dlopen failed: library libc++_shared.so not
+// found" — which is how this was found, on a phone.
+#cgo LDFLAGS: -lsignal_ffi -ldl -lm -lz -lc++_static -lc++abi
+*/
+import "C"
diff --git a/pkg/libsignalgo/svr2.go b/pkg/libsignalgo/svr2.go
new file mode 100644
index 0000000..4706cfe
--- /dev/null
+++ b/pkg/libsignalgo/svr2.go
@@ -0,0 +1,105 @@
+package libsignalgo
+
+/*
+#include "./libsignal-ffi.h"
+#include <stdlib.h>
+*/
+import "C"
+import (
+	"runtime"
+	"time"
+)
+
+// PinHash is the Argon2 stretch of a Signal PIN, from which the two keys SVR2
+// needs are derived: the access key it is queried with, and the encryption key
+// that unwraps whatever comes back.
+type PinHash struct {
+	nc  noCopy
+	ptr *C.SignalPinHash
+}
+
+func wrapPinHash(ptr *C.SignalPinHash) *PinHash {
+	ph := &PinHash{ptr: ptr}
+	runtime.SetFinalizer(ph, (*PinHash).Destroy)
+	return ph
+}
+
+func (ph *PinHash) mutPtr() C.SignalMutPointerPinHash {
+	return C.SignalMutPointerPinHash{ph.ptr}
+}
+
+func (ph *PinHash) constPtr() C.SignalConstPointerPinHash {
+	return C.SignalConstPointerPinHash{ph.ptr}
+}
+
+func (ph *PinHash) Destroy() error {
+	if ph == nil || ph.ptr == nil {
+		return nil
+	}
+	runtime.SetFinalizer(ph, nil)
+	err := C.signal_pin_hash_destroy(ph.mutPtr())
+	ph.ptr = nil
+	return wrapError(err)
+}
+
+// PinHashFromUsernameMrenclave stretches a PIN for one specific enclave. The
+// mrenclave is part of the salt, so a hash is only usable against the enclave
+// it was made for — rotating enclaves invalidates it by construction.
+func PinHashFromUsernameMrenclave(pin []byte, username string, mrenclave []byte) (*PinHash, error) {
+	var out C.SignalMutPointerPinHash
+	usernameC, freeUsername := GoStringToCString(username)
+	defer freeUsername()
+	signalFfiError := C.signal_pin_hash_from_username_mrenclave(
+		&out,
+		BytesToBuffer(pin),
+		usernameC,
+		BytesToBuffer(mrenclave),
+	)
+	runtime.KeepAlive(pin)
+	runtime.KeepAlive(mrenclave)
+	if signalFfiError != nil {
+		return nil, wrapError(signalFfiError)
+	}
+	return wrapPinHash(out.raw), nil
+}
+
+// AccessKey is what SVR2 is queried with; it never reveals the PIN.
+func (ph *PinHash) AccessKey() ([]byte, error) {
+	var out fixedArray32
+	signalFfiError := C.signal_pin_hash_access_key(out.cFixedArray(), ph.constPtr())
+	runtime.KeepAlive(ph)
+	if signalFfiError != nil {
+		return nil, wrapError(signalFfiError)
+	}
+	return out[:], nil
+}
+
+// EncryptionKey unwraps the blob SVR2 returns.
+func (ph *PinHash) EncryptionKey() ([]byte, error) {
+	var out fixedArray32
+	signalFfiError := C.signal_pin_hash_encryption_key(out.cFixedArray(), ph.constPtr())
+	runtime.KeepAlive(ph)
+	if signalFfiError != nil {
+		return nil, wrapError(signalFfiError)
+	}
+	return out[:], nil
+}
+
+// NewSVR2ClientState opens an attested channel to an SVR2 enclave. Same shape
+// as NewCDS2ClientState — both are SGX enclaves and share the handshake, so the
+// SGXClientState methods work unchanged.
+func NewSVR2ClientState(mrenclave, attestationMessage []byte, currentTime time.Time) (*SGXClientState, error) {
+	var out C.SignalMutPointerSgxClientState
+	signalFfiError := C.signal_svr2_client_new(
+		&out,
+		BytesToBuffer(mrenclave),
+		BytesToBuffer(attestationMessage),
+		C.uint64_t(currentTime.UnixMilli()),
+	)
+	runtime.KeepAlive(mrenclave)
+	runtime.KeepAlive(attestationMessage)
+	if signalFfiError != nil {
+		return nil, wrapError(signalFfiError)
+	}
+	return wrapSGXClientState(out.raw), nil
+}
diff --git a/pkg/signalmeow/profileupload.go b/pkg/signalmeow/profileupload.go
new file mode 100644
index 0000000..35e5ba7
--- /dev/null
+++ b/pkg/signalmeow/profileupload.go
@@ -0,0 +1,188 @@
+package signalmeow
+
+// Writing our own Signal profile.
+//
+// Upstream signalmeow only reads profiles. Publishing one is PUT /v1/profile
+// with every field encrypted under the account's profile key and padded to a
+// fixed length, plus a zkgroup commitment proving the version belongs to us.
+// The padding is not cosmetic: the ciphertext length is visible to the server,
+// so Signal fixes it per field to stop the length leaking the value.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+
+	"go.mau.fi/mautrix-signal/pkg/libsignalgo"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/web"
+)
+
+const (
+	// Signal's own bucket sizes. A name over 53 bytes moves to the larger
+	// bucket rather than being rejected.
+	profileNameShortPadding = 53
+	profileNameLongPadding  = 257
+	profileAboutPadding     = 512
+)
+
+type profileUploadRequest struct {
+	Version        string `json:"version"`
+	Name           string `json:"name"`
+	About          string `json:"about"`
+	Avatar         bool   `json:"avatar"`
+	SameAvatar     bool   `json:"sameAvatar"`
+	Commitment     string `json:"commitment"`
+}
+
+// updateAccountAttributes rewrites the account attributes.
+//
+// Always the complete set: the endpoint replaces the stored object wholesale,
+// so sending one field alone drops registration ids, capabilities and the
+// unidentified access key with it.
+func (cli *Client) updateAccountAttributes(ctx context.Context, discoverable bool, accessKey []byte) error {
+	attrs := map[string]any{
+		"fetchesMessages":                true,
+		"registrationId":                 cli.Store.ACIRegistrationID,
+		"pniRegistrationId":              cli.Store.PNIRegistrationID,
+		"capabilities":                   signalCapabilities,
+		"unrestrictedUnidentifiedAccess": false,
+		"discoverableByPhoneNumber":      discoverable,
+	}
+	if len(accessKey) > 0 {
+		attrs["unidentifiedAccessKey"] = base64.StdEncoding.EncodeToString(accessKey)
+	}
+	body, err := json.Marshal(attrs)
+	if err != nil {
+		return err
+	}
+	username, password := cli.Store.BasicAuthCreds()
+	resp, err := web.SendHTTPRequest(
+		ctx, web.APIHostname, http.MethodPut, "/v1/accounts/attributes/", &web.HTTPReqOpt{
+			Body:        body,
+			Username:    &username,
+			Password:    &password,
+			ContentType: web.ContentTypeJSON,
+		},
+	)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("attribute update returned %d: %s", resp.StatusCode, string(raw))
+	}
+	return nil
+}
+
+// ensureProfileKey returns the account's profile key, minting one if the store
+// has none.
+//
+// Accounts registered before the key was persisted have nothing here. Minting a
+// replacement also changes the derived unidentified access key, so the server
+// copy has to be updated in the same breath or sealed-sender delivery to this
+// account starts failing.
+func (cli *Client) ensureProfileKey(ctx context.Context, discoverable bool) (libsignalgo.ProfileKey, error) {
+	stored, err := cli.Store.RecipientStore.MyProfileKey(ctx)
+	if err != nil {
+		return libsignalgo.ProfileKey{}, fmt.Errorf("failed to load own profile key: %w", err)
+	}
+	if stored != nil && !stored.IsEmpty() {
+		return *stored, nil
+	}
+
+	var key libsignalgo.ProfileKey
+	if _, err := rand.Read(key[:]); err != nil {
+		return key, fmt.Errorf("failed to generate profile key: %w", err)
+	}
+	accessKey, err := key.DeriveAccessKey()
+	if err != nil {
+		return key, fmt.Errorf("failed to derive access key: %w", err)
+	}
+	if err := cli.updateAccountAttributes(ctx, discoverable, accessKey[:]); err != nil {
+		return key, fmt.Errorf("failed to publish new access key: %w", err)
+	}
+	if err := cli.Store.RecipientStore.StoreProfileKey(ctx, cli.Store.ACI, key); err != nil {
+		return key, fmt.Errorf("failed to store profile key: %w", err)
+	}
+	return key, nil
+}
+
+// UpdateProfile publishes the account's display name and about text.
+func (cli *Client) UpdateProfile(ctx context.Context, name, about string, discoverable bool) error {
+	key, err := cli.ensureProfileKey(ctx, discoverable)
+	if err != nil {
+		return err
+	}
+
+	namePadding := profileNameShortPadding
+	if len(name) > profileNameShortPadding {
+		namePadding = profileNameLongPadding
+	}
+	encryptedName, err := encryptString(key, name, namePadding)
+	if err != nil {
+		return fmt.Errorf("failed to encrypt name: %w", err)
+	}
+	encryptedAbout, err := encryptString(key, about, profileAboutPadding)
+	if err != nil {
+		return fmt.Errorf("failed to encrypt about: %w", err)
+	}
+	version, err := key.GetProfileKeyVersion(cli.Store.ACI)
+	if err != nil {
+		return fmt.Errorf("failed to derive profile key version: %w", err)
+	}
+	commitment, err := key.GetCommitment(cli.Store.ACI)
+	if err != nil {
+		return fmt.Errorf("failed to derive profile key commitment: %w", err)
+	}
+
+	// sameAvatar keeps whatever avatar is already published: this call only
+	// changes the text fields, and omitting it would clear the picture.
+	body, err := json.Marshal(profileUploadRequest{
+		Version:    string(version[:]),
+		Name:       base64.StdEncoding.EncodeToString(encryptedName),
+		About:      base64.StdEncoding.EncodeToString(encryptedAbout),
+		Avatar:     false,
+		SameAvatar: true,
+		Commitment: base64.StdEncoding.EncodeToString(commitment[:]),
+	})
+	if err != nil {
+		return err
+	}
+
+	username, password := cli.Store.BasicAuthCreds()
+	resp, err := web.SendHTTPRequest(ctx, web.APIHostname, http.MethodPut, "/v1/profile", &web.HTTPReqOpt{
+		Body:        body,
+		Username:    &username,
+		Password:    &password,
+		ContentType: web.ContentTypeJSON,
+	})
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("profile update returned %d: %s", resp.StatusCode, string(raw))
+	}
+	return nil
+}
+
+// SetDiscoverableByPhoneNumber controls whether contact discovery can find this
+// account by its number — the one Signal privacy setting that is an account
+// attribute rather than a client-side preference.
+func (cli *Client) SetDiscoverableByPhoneNumber(ctx context.Context, discoverable bool) error {
+	key, err := cli.ensureProfileKey(ctx, discoverable)
+	if err != nil {
+		return err
+	}
+	accessKey, err := key.DeriveAccessKey()
+	if err != nil {
+		return err
+	}
+	return cli.updateAccountAttributes(ctx, discoverable, accessKey[:])
+}
