@@ -0,0 +1,354 @@
+package signalmeow
+
+// Registering as a PRIMARY device, rather than linking as a companion.
+//
+// Upstream signalmeow only knows how to link (see provisioning.go). This adds
+// the account-registration half of the Signal service API: a verification
+// session (captcha, SMS/voice code) followed by POST /v1/registration, which
+// produces exactly the store.DeviceData that linking produces, so everything
+// downstream — sending, receiving, groups, storage service — is unchanged.
+//
+// libsignal_ffi does ship a registration client of its own, but every call in
+// it is async: it needs a Tokio runtime handle, a C-promise-to-Go callback
+// bridge and libsignal's chat-connection struct, none of which libsignalgo
+// wraps. Talking to the same REST endpoints directly reuses the HTTP layer
+// already here instead.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	mrand "math/rand/v2"
+
+	"github.com/google/uuid"
+	"github.com/rs/zerolog"
+	"go.mau.fi/util/random"
+
+	"go.mau.fi/mautrix-signal/pkg/libsignalgo"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/store"
+	"go.mau.fi/mautrix-signal/pkg/signalmeow/web"
+)
+
+// RegistrationSession is the server's view of an in-progress registration.
+type RegistrationSession struct {
+	ID                   string   `json:"id"`
+	Verified             bool     `json:"verified"`
+	RequestedInformation []string `json:"requestedInformation"`
+}
+
+// NeedsCaptcha reports whether the server is withholding the code until a
+// captcha token is submitted. It nearly always is for a new number.
+func (s *RegistrationSession) NeedsCaptcha() bool {
+	for _, info := range s.RequestedInformation {
+		if info == "captcha" {
+			return true
+		}
+	}
+	return false
+}
+
+// RegistrationError carries the HTTP status so callers can tell apart the cases
+// a user can act on: 402 captcha rejected, 409/423 registration lock, 429 rate
+// limited, 440 wrong code.
+type RegistrationError struct {
+	StatusCode int
+	Body       string
+}
+
+func (e RegistrationError) Error() string {
+	// The body is only useful when the server actually explains itself. A
+	// schema rejection comes back as a full Jetty HTML error page, and putting
+	// that on screen buried the one number that matters.
+	detail := strings.TrimSpace(e.Body)
+	if strings.HasPrefix(detail, "<") || len(detail) > 120 {
+		detail = ""
+	}
+	switch {
+	case detail != "":
+		return fmt.Sprintf("Signal rejected this (%d): %s", e.StatusCode, detail)
+	case e.StatusCode == 422:
+		return "Signal rejected the request (422)"
+	case e.StatusCode == 429:
+		return "Too many attempts, try later"
+	default:
+		return fmt.Sprintf("Signal error %d", e.StatusCode)
+	}
+}
+
+// RegistrationLockError means the number has Registration Lock enabled, so the
+// account's PIN is required. Satisfying it needs the master key out of SVR,
+// which nothing here can do yet — the user has to turn the lock off in the
+// official app first.
+type RegistrationLockError struct {
+	TimeRemainingSeconds int64 `json:"timeRemaining"`
+}
+
+func (e RegistrationLockError) Error() string {
+	return fmt.Sprintf("number has registration lock enabled (%ds remaining)", e.TimeRemainingSeconds)
+}
+
+func registrationJSON(ctx context.Context, method, path string, body any, out any) error {
+	var payload []byte
+	if body != nil {
+		var err error
+		payload, err = json.Marshal(body)
+		if err != nil {
+			return fmt.Errorf("failed to marshal %s %s: %w", method, path, err)
+		}
+	}
+	resp, err := web.SendHTTPRequest(ctx, web.APIHostname, method, path, &web.HTTPReqOpt{
+		Body:        payload,
+		ContentType: web.ContentTypeJSON,
+	})
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return RegistrationError{StatusCode: resp.StatusCode, Body: string(raw)}
+	}
+	if out == nil {
+		return nil
+	}
+	return json.Unmarshal(raw, out)
+}
+
+// CreateRegistrationSession opens a verification session for a number in E.164.
+func CreateRegistrationSession(ctx context.Context, number string) (*RegistrationSession, error) {
+	session := &RegistrationSession{}
+	err := registrationJSON(ctx, http.MethodPost, "/v1/verification/session", map[string]any{
+		"number": number,
+	}, session)
+	if err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
+// SubmitRegistrationCaptcha hands over the token from Signal's captcha page.
+// The value is the whole `signalcaptcha://...` payload the page produces.
+func SubmitRegistrationCaptcha(ctx context.Context, sessionID, token string) (*RegistrationSession, error) {
+	session := &RegistrationSession{}
+	err := registrationJSON(ctx, http.MethodPatch, "/v1/verification/session/"+sessionID, map[string]any{
+		"captcha": token,
+	}, session)
+	if err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
+// RequestRegistrationCode asks for the verification code. transport is "sms" or
+// "voice".
+func RequestRegistrationCode(ctx context.Context, sessionID, transport string) (*RegistrationSession, error) {
+	session := &RegistrationSession{}
+	err := registrationJSON(ctx, http.MethodPost, "/v1/verification/session/"+sessionID+"/code", map[string]any{
+		"transport": transport,
+		"client":    "android",
+	}, session)
+	if err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
+// SubmitRegistrationCode submits the code the user received. A 200 with
+// Verified false means the code was wrong but the session is still alive.
+func SubmitRegistrationCode(ctx context.Context, sessionID, code string) (*RegistrationSession, error) {
+	session := &RegistrationSession{}
+	err := registrationJSON(ctx, http.MethodPut, "/v1/verification/session/"+sessionID+"/code", map[string]any{
+		"code": code,
+	}, session)
+	if err != nil {
+		return nil, err
+	}
+	return session, nil
+}
+
+type registerAccountResponse struct {
+	UUID     uuid.UUID `json:"uuid"`
+	PNI      uuid.UUID `json:"pni"`
+	Number   string    `json:"number"`
+	DeviceID int       `json:"deviceId"`
+}
+
+// RegisterPrimaryDevice claims the number for this client and stores the
+// resulting account. THIS UNREGISTERS ANY OTHER PRIMARY on the same number:
+// Signal allows exactly one, so the official app on that number stops working
+// until it re-registers (which would in turn evict this one).
+func RegisterPrimaryDevice(
+	ctx context.Context,
+	deviceStore store.DeviceStore,
+	number string,
+	sessionID string,
+) (*store.Device, error) {
+	log := zerolog.Ctx(ctx).With().Str("action", "register primary").Logger()
+
+	aciIdentityKeyPair, err := libsignalgo.GenerateIdentityKeyPair()
+	if err != nil {
+		return nil, fmt.Errorf("failed to generate ACI identity key pair: %w", err)
+	}
+	pniIdentityKeyPair, err := libsignalgo.GenerateIdentityKeyPair()
+	if err != nil {
+		return nil, fmt.Errorf("failed to generate PNI identity key pair: %w", err)
+	}
+
+	// Registration IDs are 14-bit; Signal rejects anything wider. Same range
+	// the linking path uses.
+	aciRegistrationID := mrand.IntN(16383) + 1
+	pniRegistrationID := mrand.IntN(16383) + 1
+
+	aciSignedPreKey := GenerateSignedPreKey(1, aciIdentityKeyPair)
+	pniSignedPreKey := GenerateSignedPreKey(1, pniIdentityKeyPair)
+	aciPQLastResortPreKey := GenerateKyberPreKeys(1, 1, aciIdentityKeyPair)[0]
+	pniPQLastResortPreKey := GenerateKyberPreKeys(1, 1, pniIdentityKeyPair)[0]
+
+	aciSignedPreKeyJSON, err := SignedPreKeyToJSON(aciSignedPreKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode ACI signed prekey: %w", err)
+	}
+	pniSignedPreKeyJSON, err := SignedPreKeyToJSON(pniSignedPreKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode PNI signed prekey: %w", err)
+	}
+	aciPQJSON, err := KyberPreKeyToJSON(aciPQLastResortPreKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode ACI kyber prekey: %w", err)
+	}
+	pniPQJSON, err := KyberPreKeyToJSON(pniPQLastResortPreKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode PNI kyber prekey: %w", err)
+	}
+
+	aciPub, err := aciIdentityKeyPair.GetPublicKey().Serialize()
+	if err != nil {
+		return nil, fmt.Errorf("failed to serialize ACI identity key: %w", err)
+	}
+	pniPub, err := pniIdentityKeyPair.GetPublicKey().Serialize()
+	if err != nil {
+		return nil, fmt.Errorf("failed to serialize PNI identity key: %w", err)
+	}
+
+	// The server insists on an unidentified-access key. It is derived from the
+	// profile key, so a primary has to mint one at registration rather than
+	// leaving it for the first profile upload.
+	var profileKey libsignalgo.ProfileKey
+	if _, err := rand.Read(profileKey[:]); err != nil {
+		return nil, fmt.Errorf("failed to generate profile key: %w", err)
+	}
+	accessKey, err := profileKey.DeriveAccessKey()
+	if err != nil {
+		return nil, fmt.Errorf("failed to derive access key: %w", err)
+	}
+
+	password := random.String(22)
+	// The account entropy pool is the root of the master key, storage-service
+	// key and backup keys. A primary mints its own; a linked device is handed
+	// one by the primary.
+	entropyPool, err := libsignalgo.GenerateAccountEntropyPool()
+	if err != nil {
+		return nil, fmt.Errorf("failed to generate account entropy pool: %w", err)
+	}
+
+	body := map[string]any{
+		"sessionId": sessionID,
+		// Both required by the server's schema; omitting either is a bare 422
+		// with no field named.
+		"everySignedKeyValid": true,
+		"skipDeviceTransfer":  true,
+		"accountAttributes": map[string]any{
+			"fetchesMessages":   true,
+			"registrationId":    aciRegistrationID,
+			"pniRegistrationId": pniRegistrationID,
+			"capabilities":      signalCapabilities,
+			"unidentifiedAccessKey":          base64.StdEncoding.EncodeToString(accessKey[:]),
+			"unrestrictedUnidentifiedAccess": false,
+			"discoverableByPhoneNumber":      true,
+			// No "name": for a primary the server wants either an absent field
+			// or base64 of an ENCRYPTED device name. A plain string is rejected.
+		},
+		"aciIdentityKey":        base64.StdEncoding.EncodeToString(aciPub),
+		"pniIdentityKey":        base64.StdEncoding.EncodeToString(pniPub),
+		"aciSignedPreKey":       aciSignedPreKeyJSON,
+		"pniSignedPreKey":       pniSignedPreKeyJSON,
+		"aciPqLastResortPreKey": aciPQJSON,
+		"pniPqLastResortPreKey": pniPQJSON,
+	}
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return nil, fmt.Errorf("failed to marshal registration: %w", err)
+	}
+
+	// Basic auth with the password we just minted: the account does not exist
+	// yet, so there is nothing else to authenticate with.
+	resp, err := web.SendHTTPRequest(ctx, web.APIHostname, http.MethodPost, "/v1/registration", &web.HTTPReqOpt{
+		Body:        payload,
+		Username:    &number,
+		Password:    &password,
+		ContentType: web.ContentTypeJSON,
+	})
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	if resp.StatusCode == http.StatusLocked || resp.StatusCode == http.StatusConflict {
+		lockErr := RegistrationLockError{}
+		_ = json.Unmarshal(raw, &lockErr)
+		return nil, lockErr
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, RegistrationError{StatusCode: resp.StatusCode, Body: string(raw)}
+	}
+
+	account := registerAccountResponse{}
+	if err := json.Unmarshal(raw, &account); err != nil {
+		return nil, fmt.Errorf("failed to parse registration response: %w", err)
+	}
+
+	deviceID := account.DeviceID
+	if deviceID == 0 {
+		deviceID = 1
+	}
+	data := &store.DeviceData{
+		ACIIdentityKeyPair: aciIdentityKeyPair,
+		PNIIdentityKeyPair: pniIdentityKeyPair,
+		ACIRegistrationID:  aciRegistrationID,
+		PNIRegistrationID:  pniRegistrationID,
+		ACI:                account.UUID,
+		PNI:                account.PNI,
+		DeviceID:           deviceID,
+		Number:             number,
+		Password:           password,
+		AccountEntropyPool: entropyPool,
+	}
+	data.MasterKey, err = entropyPool.DeriveSVRKey()
+	if err != nil {
+		// Not fatal for messaging, but storage service and backups need it.
+		log.Err(err).Msg("failed to derive master key from account entropy pool")
+	}
+
+	if err := deviceStore.PutDevice(ctx, data); err != nil {
+		return nil, fmt.Errorf("failed to store registered device: %w", err)
+	}
+	device, err := deviceStore.DeviceByACI(ctx, data.ACI)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load registered device: %w", err)
+	}
+	// Persist the profile key we just minted. It is not only the account's own
+	// profile encryption key — the unidentified access key sent above derives
+	// from it — so losing it means never being able to publish a profile.
+	if err := device.RecipientStore.StoreProfileKey(ctx, data.ACI, profileKey); err != nil {
+		log.Err(err).Msg("failed to store own profile key")
+	}
+	return device, nil
+}
+
+
