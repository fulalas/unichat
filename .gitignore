# Local build toolchain (JDK, Android SDK, Go, Gradle)
/toolchain/

# Gradle caches and build outputs
.gradle/
build/
app/build/

# Generated Go bridge (built by build.sh)
app/libs/wmbridge.aar
app/libs/wmbridge-sources.jar

# whatsmeow sources fetched by build.sh (pinned, not vendored)
gobridge/ext/whatsmeow/

# signalmeow sources fetched by build.sh, and the libsignal_ffi.a that
# build-libsignal.sh cross-compiles against them
gobridge/ext/signal/
gobridge/ext/libsignal/

# Final APK dropped in the repo root by build.sh
/unichat-*.apk

# Machine-specific SDK location
local.properties
telegram.properties
tdjson/ext/
app/src/main/jniLibs/

# weekly upstream-poll stamp
gobridge/ext/.upstream-checked

# TDLib sources, fetched by build-tdlib.sh (tracks upstream master)
tdjson/td/
